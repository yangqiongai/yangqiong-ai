<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yangqiongai.ai</groupId>
        <artifactId>yangqiong-ai-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>yangqiong-ai-platform-connector</artifactId>
    <name>yangqiong-ai-platform-connector</name>
    <description>AI 连接器生态模块（钉钉/企微/飞书/数据库/文档解析等外部能力成品化接入）</description>

    <dependencies>
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-platform-bss</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-common</artifactId>
        </dependency>
        <!-- 连接器工具落地为AgentTool SPI -->
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-agent-runtime</artifactId>
        </dependency>
        <!-- Toolkit装配缝隙：ToolExtraContributor -->
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-agent-tool</artifactId>
        </dependency>

        <!-- 集成发送记录实体与Mapper（IntegrationRecord）由本模块自持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据库连接器独立只读小连接池（C2启用） -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 文档解析连接器：PDF文本层提取与OCR图像渲染（C5启用） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- 文档解析连接器：Word表格线性化与Excel按sheet分块（C5启用） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <!-- 数据库连接器单测内嵌库（仅测试） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit 架构边界测试 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
