<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yangqiongai.ai</groupId>
    <artifactId>yangqiong-ai-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>yangqiong-ai-bom</name>
    <description>泱穹 AI 社区版 BOM（版本列车唯一入口，聚合框架层与平台层全部社区构件版本管理）</description>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <ai.version>1.0.0-SNAPSHOT</ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 聚合框架层根 pom 版本管理（含第三方依赖版本列车） -->
            <dependency>
                <groupId>com.yangqiongai.ai</groupId>
                <artifactId>yangqiong-ai-framework</artifactId>
                <version>${ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 聚合平台层根 pom 版本管理（平台业务构件版本） -->
            <dependency>
                <groupId>com.yangqiongai.ai</groupId>
                <artifactId>yangqiong-ai-platform</artifactId>
                <version>${ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
