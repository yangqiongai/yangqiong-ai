<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.yangqiongai.ai</groupId>
        <artifactId>yangqiong-ai-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>yangqiong-ai-workflow</artifactId>
    <name>yangqiong-ai-workflow</name>
    <description>AI 工作流引擎模块</description>

    <dependencies>
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-agent-core</artifactId>
        </dependency>
        <!-- 工作流定时调度：复用AgentSchedulerProvider调度器获取机制（企业版集群/社区版内存降级） -->
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-agent-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yangqiongai.ai</groupId>
            <artifactId>yangqiong-ai-approval</artifactId>
        </dependency>
        <!-- 引擎定时调度扩展：时间控制节点的cron表达式解析与下次触发时间计算 -->
        <dependency>
            <groupId>com.yangqiongai.agent</groupId>
            <artifactId>yangqiong-agent-cron</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 数据库状态存储（JdbcWorkflowStateStore，无数据源时不装配） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JS脚本引擎（JDK15起移除内置Nashorn，脚本表达式节点需要） -->
        <dependency>
            <groupId>org.openjdk.nashorn</groupId>
            <artifactId>nashorn-core</artifactId>
            <version>15.4</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
