{
  "name": "@yq/workflow",
  "version": "0.1.0",
  "description": "YangQiong AI 工作流编辑器组件库（编辑器框架 + 标准节点 + dev 调试场）",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/yq-workflow.umd.cjs",
  "module": "./dist/yq-workflow.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yq-workflow.js",
      "require": "./dist/yq-workflow.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.41.5",
    "@vue-flow/minimap": "^1.5.0",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "vue": "^3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^2.2.8"
  }
}
